<?xml version="1.0" encoding="UTF-8"?>
<!--
  Copy this file to adapters/ios-keyboard/ExportOptions.plist (git-ignored) and adjust.
  Read by `xcodebuild -exportArchive` to turn dist/ios/*.xcarchive into a signed .ipa.
  The signing certs + provisioning profiles live in your keychain / Apple Developer
  account (Team 9289LTXAT7); this file only selects the distribution method.

  method: app-store  (App Store / TestFlight) | ad-hoc | development | enterprise
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>method</key>          <string>app-store</string>
  <key>teamID</key>          <string>9289LTXAT7</string>
  <key>signingStyle</key>    <string>automatic</string>
  <key>uploadSymbols</key>   <true/>
  <key>stripSwiftSymbols</key><true/>
</dict>
</plist>
