    "support.body" : {
      "extractionState" : "manual",
      "localizations" : { "km" : { "stringUnit" : { "state" : "translated", "value" : "KhmerIME គឺជាគម្រោងប្រភពកូដចំហ។ ការគាំទ្ររបស់អ្នកជួយឱ្យការអភិវឌ្ឍ ការសាកល្បង ការខ្ចប់ និងភាពប្រសើរឡើងនាពេលអនាគតបន្តដំណើរ។" } } }
