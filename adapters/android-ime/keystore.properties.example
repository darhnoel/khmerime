# Copy this file to adapters/android-ime/keystore.properties (git-ignored) and fill in.
# Read by app/build.gradle.kts to sign the release .aab/.apk.
#
# Google Play: you only need an UPLOAD key here — Play App Signing re-signs with the
# real app key on upload. Direct .apk sideload: this key signs the installable artifact.
# Generate one: keytool -genkey -v -keystore khmerime-upload.jks -keyalg RSA -keysize 2048 \
#                       -validity 10000 -alias khmerime

storeFile=/absolute/path/to/khmerime-upload.jks
storePassword=CHANGEME
keyAlias=khmerime
keyPassword=CHANGEME
