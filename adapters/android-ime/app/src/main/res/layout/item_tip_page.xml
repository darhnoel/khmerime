<?xml version="1.0" encoding="utf-8"?>
<!-- One swipeable tip page (iOS TipsViewController parity). Bound by TipsFragment's
     adapter; icon/headline/body are set per position. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical"
    android:paddingStart="40dp"
    android:paddingEnd="40dp"
    android:paddingBottom="24dp">

    <ImageView
        android:id="@+id/tip_icon"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:contentDescription="@null"
        android:importantForAccessibility="no"
        android:padding="6dp"
        android:src="@drawable/ic_tip_keyboard"
        android:tint="@color/brand_amber" />

    <TextView
        android:id="@+id/tip_headline"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:fontFamily="sans-serif"
        android:gravity="center"
        android:text="@string/tip_1_headline"
        android:textColor="@color/brand_ivory"
        android:textSize="24sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tip_body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:fontFamily="sans-serif"
        android:gravity="center"
        android:lineSpacingExtra="3dp"
        android:text="@string/tip_1_body"
        android:textColor="@color/brand_ivory_dim"
        android:textSize="17sp" />
</LinearLayout>
