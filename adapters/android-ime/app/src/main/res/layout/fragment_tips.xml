<?xml version="1.0" encoding="utf-8"?>
<!-- Swipeable tips carousel (iOS TipsViewController parity): a horizontal pager of
     tip pages with a dot indicator, instead of a vertical scroll of stacked cards. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/brand_ink"
    android:orientation="vertical"
    android:paddingTop="48dp"
    android:paddingBottom="32dp">

    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/tips_pager"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Page dots. TabLayout in unclickable dot mode mirrors iOS UIPageControl.
         Each tab must be at least as wide as the dot + its 6dp side insets (8+6+6
         = 20dp), or the tab collapses and the dot vanishes. The insets provide the
         gap between dots; tab padding stays 0. -->
    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tips_dots"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:background="@android:color/transparent"
        app:tabBackground="@drawable/tip_dot"
        app:tabGravity="center"
        app:tabIndicatorHeight="0dp"
        app:tabMinWidth="20dp"
        app:tabPaddingBottom="0dp"
        app:tabPaddingEnd="0dp"
        app:tabPaddingStart="0dp"
        app:tabPaddingTop="0dp" />
</LinearLayout>
