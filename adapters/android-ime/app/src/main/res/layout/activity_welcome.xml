<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/brand_ink">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="32dp"
        android:paddingEnd="32dp">

        <Space
            android:layout_width="1dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <ImageView
            android:id="@+id/logoCard"
            android:layout_width="132dp"
            android:layout_height="132dp"
            android:contentDescription="@string/welcome_logo_content_description"
            android:scaleType="fitCenter"
            android:src="@drawable/khmerime_logo_card" />

        <TextView
            android:id="@+id/welcomeTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:fontFamily="sans-serif"
            android:includeFontPadding="false"
            android:letterSpacing="0"
            android:text="@string/app_name"
            android:textColor="@color/brand_ivory"
            android:textSize="36sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/welcomeSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:fontFamily="sans-serif"
            android:includeFontPadding="false"
            android:letterSpacing="0"
            android:text="@string/welcome_subtitle"
            android:textColor="@color/brand_amber"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/welcomeTagline"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:fontFamily="sans-serif"
            android:gravity="center"
            android:includeFontPadding="false"
            android:letterSpacing="0"
            android:lineSpacingExtra="3dp"
            android:text="@string/welcome_tagline"
            android:textColor="@color/brand_ivory_dim"
            android:textSize="16sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/getStartedButton"
            android:layout_width="220dp"
            android:layout_height="52dp"
            android:layout_marginTop="30dp"
            android:backgroundTint="@color/brand_amber"
            android:fontFamily="sans-serif"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:letterSpacing="0"
            android:text="@string/welcome_get_started"
            android:textAllCaps="false"
            android:textColor="@color/brand_ink"
            android:textSize="18sp"
            android:textStyle="bold"
            app:cornerRadius="26dp" />

        <TextView
            android:id="@+id/openKeyboardLink"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="sans-serif"
            android:gravity="center"
            android:includeFontPadding="false"
            android:letterSpacing="0"
            android:paddingVertical="8dp"
            android:text="@string/welcome_already_enabled"
            android:textColor="@color/brand_ivory_dim"
            android:textSize="14sp" />

        <Space
            android:layout_width="1dp"
            android:layout_height="0dp"
            android:layout_weight="1" />
    </LinearLayout>
</FrameLayout>
