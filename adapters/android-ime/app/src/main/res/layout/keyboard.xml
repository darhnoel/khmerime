<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#D1D5DB">

    <!-- Preedit strip: roman row + tappable Khmer segment row -->
    <com.khmerime.views.PreeditStripView
        android:id="@+id/preedit_strip"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:visibility="gone"
        android:background="@android:color/transparent" />

    <!-- Candidate strip -->
    <HorizontalScrollView
        android:id="@+id/candidate_scroll"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:visibility="gone"
        android:background="@android:color/transparent"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/candidate_strip"
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="match_parent" />
    </HorizontalScrollView>

    <LinearLayout
        android:id="@+id/keyboard_layer"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="216dp"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="8dp"
        android:layout_marginStart="2dp"
        android:layout_marginEnd="2dp">
    </LinearLayout>

    <View
        android:id="@+id/system_bottom_spacer"
        android:layout_width="match_parent"
        android:layout_height="12dp" />

</LinearLayout>
