<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/brand_ink">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="28dp"
        android:paddingEnd="28dp">

        <Space
            android:layout_width="1dp"
            android:layout_height="0dp"
            android:layout_weight="0.55" />

        <TextView
            android:id="@+id/setupGuideTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif"
            android:includeFontPadding="false"
            android:letterSpacing="0"
            android:text="@string/setup_guide_title"
            android:textColor="@color/brand_ivory"
            android:textSize="38sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/setupGuideSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:fontFamily="sans-serif"
            android:includeFontPadding="false"
            android:letterSpacing="0"
            android:lineSpacingExtra="4dp"
            android:text="@string/setup_guide_subtitle"
            android:textColor="@color/brand_mist"
            android:textSize="18sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="48dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/step1Badge"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:background="@drawable/setup_step_badge"
                android:fontFamily="sans-serif"
                android:gravity="center"
                android:includeFontPadding="false"
                android:letterSpacing="0"
                android:text="1"
                android:textColor="@color/brand_ink"
                android:textSize="24sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif"
                    android:includeFontPadding="false"
                    android:letterSpacing="0"
                    android:text="@string/setup_step_1_title"
                    android:textColor="@color/brand_ivory"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:fontFamily="sans-serif"
                    android:includeFontPadding="false"
                    android:letterSpacing="0"
                    android:lineSpacingExtra="3dp"
                    android:text="@string/setup_step_1_body"
                    android:textColor="@color/brand_ivory_dim"
                    android:textSize="15sp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/step2Badge"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:background="@drawable/setup_step_badge"
                android:fontFamily="sans-serif"
                android:gravity="center"
                android:includeFontPadding="false"
                android:letterSpacing="0"
                android:text="2"
                android:textColor="@color/brand_ink"
                android:textSize="24sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif"
                    android:includeFontPadding="false"
                    android:letterSpacing="0"
                    android:text="@string/setup_step_2_title"
                    android:textColor="@color/brand_ivory"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:fontFamily="sans-serif"
                    android:includeFontPadding="false"
                    android:letterSpacing="0"
                    android:lineSpacingExtra="3dp"
                    android:text="@string/setup_step_2_body"
                    android:textColor="@color/brand_ivory_dim"
                    android:textSize="15sp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/step3Badge"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:background="@drawable/setup_step_badge"
                android:fontFamily="sans-serif"
                android:gravity="center"
                android:includeFontPadding="false"
                android:letterSpacing="0"
                android:text="3"
                android:textColor="@color/brand_ink"
                android:textSize="24sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif"
                    android:includeFontPadding="false"
                    android:letterSpacing="0"
                    android:text="@string/setup_step_3_title"
                    android:textColor="@color/brand_ivory"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:fontFamily="sans-serif"
                    android:includeFontPadding="false"
                    android:letterSpacing="0"
                    android:lineSpacingExtra="3dp"
                    android:text="@string/setup_step_3_body"
                    android:textColor="@color/brand_ivory_dim"
                    android:textSize="15sp" />
            </LinearLayout>
        </LinearLayout>

        <Space
            android:layout_width="1dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/openSettingsButton"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:backgroundTint="@color/brand_amber"
            android:fontFamily="sans-serif"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:letterSpacing="0"
            android:text="@string/setup_open_settings"
            android:textAllCaps="false"
            android:textColor="@color/brand_ink"
            android:textSize="18sp"
            android:textStyle="bold"
            app:cornerRadius="26dp" />

        <TextView
            android:id="@+id/openKeyboardPickerLink"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="sans-serif"
            android:gravity="center"
            android:includeFontPadding="false"
            android:letterSpacing="0"
            android:paddingVertical="8dp"
            android:text="@string/setup_open_keyboard_picker"
            android:textColor="@color/brand_ivory_dim"
            android:textSize="14sp" />

        <Space
            android:layout_width="1dp"
            android:layout_height="0dp"
            android:layout_weight="0.45" />
    </LinearLayout>
</FrameLayout>
