    <string name="tip_1_headline">Type roman, get Khmer</string>
    <string name="tip_1_body">Type somreach and KhmerIME suggests សម្រាក. Tap a candidate or press return to commit.</string>
    <string name="tip_2_headline">Long words, split up</string>
    <string name="tip_2_body">For long compositions KhmerIME shows segmented previews you can step through with left and right arrows.</string>
    <string name="tip_3_headline">Names and loanwords</string>
    <string name="tip_3_body">Press the star key for CharPick. Type a roman letter to see matching Khmer characters, then tap one to insert it.</string>
    <string name="tip_4_headline">English when you need it</string>
    <string name="tip_4_body">Press EN to pass keys straight through to the app. Press EN again to return to Khmer.</string>

