/target
**/*.rs.bk
*.wasm
/examples/test.wat

# Local tooling
.venv/
.lexicon-editor/

# Python caches
__pycache__/
*.py[cod]
.pytest_cache/

# Dioxus/web build output
dist/

# Generated binary data assets (copied here by build.rs for wasm32+fetch-data builds)
assets/data/

# Dioxus/Linux
vendor/
!tools/lexicon-editor/static/vendor/
!tools/lexicon-editor/static/vendor/tabulator/
!tools/lexicon-editor/static/vendor/tabulator/**

# Editor and OS noise
.DS_Store
Thumbs.db

# Local notes
notes/*.local.md
adapters/ios-keyboard/DEVICE_INSTALL.md
adapters/macos-imk/DEBUGGING-NOTES.md
backup/

# Generated by tools/local-en-kh-inspector/watch_short_words.sh
short-common-en-words.txt

# Claude skills install lock (local)
skills-lock.json

# data
data/khPOS/
data/khmerlang-mobile-keyboard-data/

# iOS build artifacts and generated files
adapters/ios-keyboard/swift/Frameworks/
adapters/ios-keyboard/swift/KhmerIMEKeyboard/Generated/
# Generated by xcodegen — source of truth is project.yml
adapters/ios-keyboard/swift/*.xcodeproj/

# macOS build artifacts and local Xcode state
adapters/macos-imk/macos-signing.local.mk
adapters/macos-imk/swift/Frameworks/KhmerIME.xcframework/macos-arm64_x86_64/libkhmerime_macos_imk.a
adapters/macos-imk/swift/**/xcuserdata/
adapters/macos-imk/swift/**/*.xcuserdata/
adapters/macos-imk/swift/**/*.xcuserdatad/
adapters/macos-imk/swift/**/*.xcuserstate
