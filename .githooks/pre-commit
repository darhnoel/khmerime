#!/bin/sh
# Block accidental staging of cross-compiled native libraries.
# .so files in jniLibs/ are generated by cargo-ndk and must not be committed.
staged=$(git diff --cached --name-only)
if echo "$staged" | grep -q '\.so$'; then
    echo "pre-commit: staged .so files detected:"
    echo "$staged" | grep '\.so$'
    echo ""
    echo "These are cross-compiled native libraries (generated by 'cargo ndk')."
    echo "Remove them from staging with:"
    echo "  git restore --staged '*.so'"
    exit 1
fi
